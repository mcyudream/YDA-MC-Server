{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "server",
  "entrypoints": {
    "server": [
      "online.yudream.minecraft.bridge.fabric.YudreamFabricMod"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_min_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
